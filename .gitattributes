# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Ignore all test and documentation with "export-ignore".
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/art                export-ignore
/docs               export-ignore
/tests              export-ignore
/.editorconfig      export-ignore
/.php_cs.dist.php   export-ignore
/psalm.xml          export-ignore
/psalm.xml.dist     export-ignore
/testbench.yaml     export-ignore
/UPGRADING.md       export-ignore
/phpstan.neon.dist  export-ignore
/phpstan-baseline.neon  export-ignore
/skills             export-ignore
/.claude-plugin     export-ignore
/scripts            export-ignore

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Teach git where a PHP function starts, so `git diff` hunk headers name the
# enclosing method. Without this, indented methods are invisible to git's
# funcname machinery and every diff in a class reads as one section — which
# breaks hunk-level commit splitting and symbol-addressed edits.
*.php diff=php

# Pest tests are top-level `it(...)` / `test(...)` closures, not methods, so the
# stock php driver treats a whole test file as one section. This driver opens a
# section per test, making one-commit-per-test enforceable.
# Requires (once per clone):
#   git config diff.pest.xfuncname '^(it|test)\(.*$'
tests/**/*.php diff=pest

# A markdown file's sections are its headings. Without this, git's funcname falls
# back to whatever line precedes a hunk, which in prose is a sentence: a change in
# docs/reference/exceptions.md was labelled "Thrown when `definition()` is not
# implemented…" and one in upgrading.md got the paragraph above it. Neither is a
# section a reader of those files would recognise, and hunk-level commit splitting
# groups by exactly that label. With the driver they become "### MachineDefinition
# NotFoundException" and "## Version Compatibility".
*.md diff=markdown
